<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Novo Abastecimento"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Data (DD/MM/AAAA)"
                android:inputType="date" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editHodometro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Hodômetro Atual (km)"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editLitros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Litros Abastecidos"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editValorLitro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Valor por Litro (R$)"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de Combustível:"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <RadioGroup
            android:id="@+id/rgCombustivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbGasolina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gasolina"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbEtanol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Etanol"
                android:layout_marginStart="16dp" />

            <RadioButton
                android:id="@+id/rbDiesel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diesel"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Registrar e Calcular"
            android:textSize="18sp"
            android:backgroundTint="#1976D2" />

        <Button
            android:id="@+id/btnAbrirCalculadora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Comparador Etanol vs Gasolina"
            android:backgroundTint="#455A64" />

        <TextView
            android:id="@+id/textResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="#ECEFF1"
            android:textColor="#263238"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:text="Cadastre um abastecimento para ver a média." />

    </LinearLayout>
</ScrollView>